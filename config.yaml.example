# LiveAi Configuration Template
# Copy this file to config.yaml and fill in your credentials

napcat:
  ws_url: "ws://localhost:3001/ws"
  http_url: "http://localhost:8080"
  http_access_token: "your_token_here"
  self_id: 1234567890

satangyun:
  target_group_id: 750742812
  auth_api_base: "https://auth.example.com"
  admin_token: "your_admin_token"
  notice_image_url: "https://example.com/notice.jpg"
  normal_draw_url: "https://example.com/generate"
  normal_draw_token: "your_draw_token"
  welcome_model: "gpt-4o-mini"

ai:
  enabled: true
  admin_qq: 123456789
  master_qq: 123456789  # 主人QQ号，AI会识别为"主人"并给予最高信任
  global_trigger_rate: 0.08  # 全局群聊随机触发概率；管理员可用 /trigger 动态修改

  # 模型/渠道配置统一在 data/models_config.json 中管理
  models_config_path: "data/models_config.json"

  # Storage and prompts
  storage_path: "data/msgs/ai_state.json"
  main_prompt_path: "data/prompt/main.txt"
  staff_prompt_path: "data/prompt/staff.txt"
  char_prompt_path: "data/prompt/char.txt"
  tasker_prompt_path: "data/prompt/dev_agent.txt"  # preferred name; legacy dev_agent_prompt_path is still accepted

  # Runtime
  worker_count: 2  # 旧配置兼容回退，不再限制会话 actor 数量
  chat_model_workers: 8  # 聊天模型专用线程，不与后台任务争用
  background_workers: 2  # Agent/搜索/视觉等后台任务并发上限
  history_limit: 500

  # Search (火星引擎)
  search_api_key: "your_search_api_key"
  search_base_url: "https://open.feedcoopapi.com/search_api/global_search"
  search_doc_count: 5

  # TTS（默认供 send_voice 使用）
  tts_provider: "fish_audio"
  tts_api_key: ""
  tts_reference_id: ""
  tts_base_url: "https://api.fish.audio"
  tts_model: "s2-pro"
  # 本地满穗 BERT-VITS2 示例：
  # tts_provider: "bert_vits2"
  # tts_reference_id: "1"
  # tts_base_url: "http://127.0.0.1:23456/voice/bert-vits2"
  # tts_model: ""

  # GitHub
  github_api_token: "ghp_your_github_token"

  # SSH agent（支持密钥登录或密码登录）
  # target 可以直接写 user@host，也可以写 ~/.ssh/config 里的 Host 别名
  ssh_profiles:
    - id: "prod"
      target: "root@example.com"
      root_dir: "/srv/app"
      port: 22
      identity_file: ""
      password: ""
      shell: "bash"
      strict_host_key_checking: true

  # Auto update
  update_repo_owner: "Loliyer520"
  update_repo_name: "LiveAi"
  auto_update_enabled: true
  auto_update_check_hour: 4

webui:
  enabled: true
  host: "127.0.0.1"
  port: 8765
