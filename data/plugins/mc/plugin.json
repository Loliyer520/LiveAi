            "description": "界面槽号"
          },
          "button": {
            "type": "integer",
            "description": "0=左键 1=右键",
            "default": 0
          }
        },
        "required": [
          "slot"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/inv_click?slot={{slot}}&button={{button}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_survey",
      "description": "体素网格勘察（26.2，最快）：一次把周围整盒方块抓下来本地筛，比 mc_find 的逐格扫描快一个量级，几百毫秒出结果。适合「周围是什么环境」「这附近有多少棵树/矿」「有没有水」。block=方块 id，找树写 log（=任意原木）；radius=半径格（最大32）、limit=最多报几处（默认20）、timeout=秒（默认60）。报告每处坐标和距离。只报坐标不动手，想挖用 mc_mine，想盖房用 mc_build。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "block": {
            "type": "string",
            "description": "要找的方块 id（找任意树写 log；逗号可多选）"
          },
          "radius": {
            "type": "number",
            "description": "扫描半径（格），默认 16，最大 32",
            "default": 16
          },
          "limit": {
            "type": "number",
            "description": "最多报告几处，默认 20",
            "default": 20
          },
          "timeout": {
            "type": "number",
            "description": "总超时秒数，默认 60",
            "default": 60
          }
        },
        "required": [
          "block"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/survey?block={{block}}&radius={{radius}}&limit={{limit}}&timeout={{timeout}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_build",
      "description": "3D 打印建筑（26.2）：按蓝图把方块一块块摆出来（先地板后墙再顶，已有方块自动跳过不浪费材料，缺材料如实报告缺什么）。三种蓝图来源：blueprint=预设名（house 小屋带门洞 / tower 塔 / platform 平台 / pillar 柱子 / wall 带窗墙 / arch 拱门）；shape=solid|solid|cube|hollow 配 w/h/d 尺寸自造方块体；blocks=显式清单 \"x,y,z:stone;x,y,z:dirt\"（相对锚点）。material=材料方块 id（默认stone）、at=锚点坐标 \"x,z\"（不填就在原地往上盖）、timeout=秒（默认300）。盖完汇报放了/跳过/失败多少块。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "blueprint": {
            "type": "string",
            "description": "预设蓝图名：house/tower/platform/pillar/wall/arch"
          },
          "shape": {
            "type": "string",
            "description": "自造形状：solid（实心）/ hollow（空心壳）"
          },
          "blocks": {
            "type": "string",
            "description": "显式方块清单 \"x,y,z:item;x,y,z:item\"（相对锚点）"
          },
          "material": {
            "type": "string",
            "description": "材料方块 id，默认 stone",
            "default": "stone"
          },
          "w": {
            "type": "number",
            "description": "shape 宽度，最大 32",
            "default": 5
          },
          "h": {
            "type": "number",
            "description": "shape 高度，最大 32",
            "default": 4
          },
          "d": {
            "type": "number",
            "description": "shape 深度，最大 32",
            "default": 5
          },
          "at": {
            "type": "string",
            "description": "锚点坐标 \"x,z\" 或 \"x,y,z\"；不填则原地往上盖"
          },
          "timeout": {
            "type": "number",
            "description": "总超时秒数，默认 300",
            "default": 300
          }
        },
        "required": []
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/build?blueprint={{blueprint}}&shape={{shape}}&blocks={{blocks}}&material={{material}}&w={{w}}&h={{h}}&d={{d}}&at={{at}}&timeout={{timeout}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_task_create",
      "description": "创建一个后台调度任务（可并行、可组合，任务自己按 tick 推进，不阻塞对话）。单任务 type：follow(跟人/生物，params={name,distance})、mine(定量采集，{block,count,range,back})、build(按蓝图盖，{shape|blueprint,material,w,h,d,hollow,at})、build_with_materials(备料建房：自动清点库存→采够材料→开盖，参数同 build 另加 mine_block/per_unit)、collect(捡掉落物，{radius})、attack(定量攻击，{name,count})、eat(饿了才吃，{below})、retaliate(巡敌反击，{radius})。复合 type：follow_and_mine（跟我走顺便挖：{name,block,count,stayWithin}——离跟随目标超过 stayWithin 格自动停手先跟上）。priority 越大越优先（100+=紧急/50-99 重要/10-49 主任务/1-9 辅助）。要「一边跟我走一边挖点木头」就用 follow_and_mine，别拆成两次阻塞调用。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "任务类型：follow / mine / build / build_with_materials / collect / attack / eat / retaliate / follow_and_mine"
          },
          "priority": {
            "type": "number",
            "description": "优先级，默认 10",
            "default": 10
          },
          "params": {
            "type": "object",
            "description": "任务参数对象，按 type 取用；如 {\"name\":\"主人\",\"block\":\"oak_log\",\"count\":10,\"stayWithin\":8}",
            "default": {}
          }
        },
        "required": [
          "type"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/schedule/create?type={{type}}&priority={{priority}}&params={{params}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_task_status",
      "description": "查调度任务：不带 id 列出全部活跃任务 + 最近结束的任务（含状态/备注/进度 state）；带 id 查单个（活跃或历史）。任务用 note/state 汇报进度，如 mine 的 {mined,target}、build 的 {placed,total}、备料建房的 {phase,have,missing}。想知道「派出去的活干到哪了/成没成」就查这个。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 id（可选；不传=全部活跃+最近结束）",
            "default": ""
          },
          "limit": {
            "type": "number",
            "description": "历史条数，默认 5",
            "default": 5
          }
        },
        "required": []
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/schedule/tasks?id={{id}}&limit={{limit}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_task_cancel",
      "description": "取消一个调度任务（按 id）。/stop 也能一次取消全部任务。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "要取消的任务 id"
          },
          "reason": {
            "type": "string",
            "description": "取消原因（写进任务备注），默认「手动取消」",
            "default": "手动取消"
          }
