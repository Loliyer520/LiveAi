    {
      "name": "mc_equip",
      "description": "把背包物品装到手上或装备栏。destination=hand/head/torso/legs/feet/off-hand，默认 hand。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "物品 id，如 iron_pickaxe/iron_helmet"
          },
          "destination": {
            "type": "string",
            "description": "hand/head/torso/legs/feet/off-hand",
            "default": "hand"
          }
        },
        "required": [
          "item"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/equip?item={{item}}&destination={{destination}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
