{
  "name": "mc",
  "description": "真实 Minecraft Java 版：进服、状态、聊天与游玩。26.2/协议776自动走本机 Rust LiveSession 后端，其他版本走 Mineflayer；仍用同一组 mc_* 工具。Rust 后端当前只接通常用状态/聊天/命令/视角/移动脱困/主手使用/快捷栏/背包/重生，未接入的工具会明确报不支持。工具持有者=Minecraft 中枢（domain:mc）与各 MC client 下级 AI（mcclient:*）。",
  "enabled": true,
  "tools": [
    {
      "name": "mc_ping",
      "description": "进服前查服务器：是否在线、版本、MOTD、在线人数、延迟。host 可写域名/IP，也可直接写 host:port；只知道地址、不确定版本时先用它。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "服务器地址（域名或 IP，也可 host:port）"
          },
          "port": {
            "type": "number",
            "description": "端口，默认 25565",
            "default": 25565
          },
          "version": {
            "type": "string",
            "description": "服务器版本，默认 auto 自动探测；探测失败再手填如 1.20.4",
            "default": "auto"
          }
        },
        "required": [
          "host"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/ping?host={{host}}&port={{port}}&version={{version}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_join",
      "description": "自主进入任意 Minecraft Java 服务器：version=auto 先探测协议再选后端（26.2/776=Rust，其他=Mineflayer），探测失败会自动退回 Mineflayer 尝试。AuthMe 类登录插件会自动识别「注册/登录/已注册/密码错误」提示并自动 /register 或 /login；密码可按 host:port 记住，首次自动生成。掉线自动重连（封禁/白名单等终止性原因不再重试）。进服后先看 mc_status、mc_events。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "服务器地址（域名或 IP，也可 host:port）"
          },
          "port": {
            "type": "number",
            "description": "端口，默认 25565",
            "default": 25565
          },
          "username": {
            "type": "string",
            "description": "游戏内用户名（3-16 位字母/数字/下划线）",
            "default": "BingTang"
          },
          "version": {
            "type": "string",
            "description": "版本，默认 auto 自动探测；连不上时手填服务器版本",
            "default": "auto"
          },
          "auth": {
            "type": "string",
            "description": "offline=离线/盗版服（默认），microsoft=微软正版登录",
            "default": "offline"
          },
          "password": {
            "type": "string",
            "description": "该服登录插件的密码；留空则用档案里记住的，首次需要注册时自动生成并记住",
            "default": ""
          },
          "register": {
            "type": "string",
            "description": "兼容参数：需要注册时用这个密码；留空等同 password",
            "default": ""
          },
          "auto_reconnect": {
            "type": "boolean",
            "description": "掉线自动重连，默认 true",
            "default": true
          },
          "backend": {
            "type": "string",
            "description": "后端，默认 auto；可强制 rust（26.2）或 mineflayer（旧版本）",
            "default": "auto"
          }
        },
        "required": [
          "host"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/join?host={{host}}&port={{port}}&username={{username}}&version={{version}}&auth={{auth}}&password={{password}}&register={{register}}&backend={{backend}}&auto_reconnect={{auto_reconnect}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_leave",
      "description": "主动下线离开 Minecraft 服务器。换服或长时间不玩前调用。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/leave",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_status",
      "description": "查看冰糖在 MC 里的实时状态：坐标、生命、饥饿、维度、时间、在线玩家、附近实体、手持和背包。每次行动后都该看一眼。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/status",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_events",
      "description": "读取服务器事件：玩家聊天、私聊、进出服、受伤、死亡、被踢。返回 next；下次带 since=上次的 next 只看新事件。聊天回复前先看这里。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "since": {
            "type": "number",
            "description": "上次返回的 next，只看比它新的事件；默认 0",
            "default": 0
          },
          "limit": {
            "type": "number",
            "description": "最多返回条数，默认 25",
            "default": 25
          }
        },
        "required": []
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/events?since={{since}}&limit={{limit}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_chat",
      "description": "在 MC 服务器公屏说话（240 字符以内）。像普通玩家一样简短自然，不要刷屏，不要暴露自己是机器人或 AI。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "要说的话"
          }
        },
        "required": [
          "message"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/chat?message={{message}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_command",
      "description": "以玩家身份执行服务器命令（/ 开头）。只有 op 或允许的命令才生效；普通玩家滥用会被踢，非必要不用。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "完整命令，如 /time set day 或 time set day"
          }
        },
        "required": [
          "command"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/command?command={{command}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_travel",
      "description": "行为层赶路（26.2）：给一个坐标，内部自动完成走、跳台阶、挖 1×2 隧道、搭桥过沟；给 y 目标高度时自动上行——实壁挖楼梯（留台阶逐格爬）、禁挖或开阔坑则垫 bridge 方块上拔。规范条件用参数声明：dig=允许挖什么（true=随意挖默认/false=禁挖/逗号清单只挖这些），bridge=搭桥/垫脚方块（不给则遇深沟即停、要上行也垫不了），tool=挖掘工具。途中受击自动反击、饥饿自动进食、低血自动停手（见 mc_behavior）。日常移动一律用它，别用 mc_goto 一步步遥控。掉坑里出不来时：带 y=地表高度+bridge=dirt 调它。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "目标 X 坐标"
          },
          "z": {
            "type": "number",
            "description": "目标 Z 坐标"
          },
          "y": {
            "type": "number",
            "description": "目标 Y 坐标。给出后成为到点硬条件（高度差>1.6 不算到达）；明显高于当前时自动上行：实壁挖楼梯、开阔坑垫 bridge 方块上拔",
            "default": ""
          },
          "dig": {
            "type": "string",
            "description": "挖掘规范：true=随意挖（默认，床岩类除外）、false=禁挖、或逗号清单如 dirt,stone,gravel",
            "default": "true"
          },
          "bridge": {
            "type": "string",
            "description": "搭桥方块 id（如 dirt）；true=自动用 dirt；留空则遇深沟/悬崖即停",
            "default": ""
          },
          "tool": {
            "type": "string",
            "description": "挖掘前确保手持的工具 id（如 iron_pickaxe），可省略",
            "default": ""
          },
          "timeout": {
            "type": "number",
            "description": "超时秒数，默认 120，范围 10-300",
            "default": 120
          }
        },
        "required": [
          "x",
          "z"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/travel?x={{x}}&z={{z}}&y={{y}}&dig={{dig}}&bridge={{bridge}}&tool={{tool}}&timeout={{timeout}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_mine",
      "description": "行为层定向采集（26.2）：给一个方块 id，自动环带外扩扫描定位（分三层覆盖头顶山地/脚下洞穴）、寻路过去（挖墙/搭桥照规范）逐块挖掉凑数，挖完可选返程回出发点。block=方块 id；找树砍树一律写 log（=任意原木标签，别猜 oak_log——林子可能是桦木/云杉），也支持逗号多选如 coal_ore,iron_ore。count=数量（默认1）、tool=挖掘工具、range=搜索半径超范围阈值（默认12；扫描走客户端本地世界缓存，毫秒级，24/32 也随便给）、timeout=总超时秒数（默认180，主要留给寻路砍树，扫描几乎不占）、back=true 完工返程。矿脉/树干会成片，挖到一块自动顺藤摸瓜。挖圆石/泥土/木头这类采集活一律用它，别手工 mc_travel+mc_dig 拼。只要知道在哪/数数、不动手挖 → 用 mc_find。目标在头顶够不着（高树残干/崖上矿）或被自己挖的坑挡住时，传 bridge=dirt（背包有土就自动垫块上拔/搭桥）；报「没给搭桥方块」就带 bridge 重试，别直接放弃问人要坐标。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "block": {
            "type": "string",
            "description": "要挖的方块 id，如 oak_log / dirt / cobblestone / coal_ore"
          },
          "count": {
            "type": "number",
            "description": "要挖的数量，默认 1，范围 1-64",
            "default": 1
          },
          "tool": {
            "type": "string",
            "description": "挖掘前确保手持的工具 id（如 iron_pickaxe），可省略",
            "default": ""
          },
          "range": {
            "type": "number",
            "description": "搜索半径（超范围阈值），默认 12，范围 2-48；扫不到就如实报告",
            "default": 12
          },
          "dig": {
            "type": "string",
            "description": "赶路挖掘规范：true=随意挖（默认）/false=禁挖/逗号清单",
            "default": "true"
          },
          "bridge": {
            "type": "string",
            "description": "搭桥/垫块方块名（如 dirt）：过深沟、爬上高目标都靠它；目标在头顶或崖上时必传",
            "default": ""
          },
          "back": {
            "type": "boolean",
            "description": "true=完工/收工后寻路返回出发点，默认 false",
            "default": false
          },
          "timeout": {
            "type": "number",
            "description": "总超时秒数，默认 180，范围 10-600",
            "default": 180
          }
        },
        "required": [
          "block"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/mine?block={{block}}&count={{count}}&tool={{tool}}&range={{range}}&dig={{dig}}&bridge={{bridge}}&back={{back}}&timeout={{timeout}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_behavior",
      "description": "行为层常驻开关与状态（26.2）：auto_retaliate 遇敌自动反击、auto_eat 饥饿自动进食、guard_health 低血停手报警。不带参数=查看当前开关/阈值/进行中任务；name=开关名+on=true/false 切换；radius/eat_below/guard_below 调阈值。受击/低血等触发器会自动变成 mc_events 事件。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "开关名：auto_retaliate / auto_eat / guard_health，留空只查询",
            "default": ""
          },
          "on": {
            "type": "boolean",
            "description": "开或关，配 name 用",
            "default": true
          },
          "radius": {
            "type": "number",
            "description": "反击索敌半径（格），默认 6",
            "default": ""
          },
          "eat_below": {
            "type": "number",
            "description": "饥饿 ≤ 此值自动进食，默认 14",
            "default": ""
          },
          "guard_below": {
            "type": "number",
            "description": "生命 ≤ 此值停手报警，默认 8",
            "default": ""
          }
        },
        "required": []
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/behavior?name={{name}}&on={{on}}&radius={{radius}}&eat_below={{eat_below}}&guard_below={{guard_below}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_goto",
      "description": "旧式直线寻路走到坐标（会被行为层打断）。y 省略时只按 x/z；range 到达半径（默认 1）。日常移动优先用 mc_travel。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "目标 X 坐标"
          },
          "z": {
            "type": "number",
            "description": "目标 Z 坐标"
          },
          "y": {
            "type": "number",
            "description": "目标 Y 坐标，可省略（留空则只按 X/Z 走）",
            "default": ""
          },
          "range": {
            "type": "number",
            "description": "到达半径（格），默认 1",
            "default": 1
          },
          "timeout": {
            "type": "number",
            "description": "超时秒数，默认 45，最大 180",
            "default": 45
          }
        },
        "required": [
          "x",
          "z"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/goto?x={{x}}&z={{z}}&y={{y}}&range={{range}}&timeout={{timeout}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_dig",
      "description": "挖掉指定坐标的方块（26.2：RCON 验证方块消失；需站在 3 格内，等 30s 内挖穿）。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "方块 X 坐标"
          },
          "y": {
            "type": "number",
            "description": "方块 Y 坐标"
          },
          "z": {
            "type": "number",
            "description": "方块 Z 坐标"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/dig?x={{x}}&y={{y}}&z={{z}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_place",
      "description": "把背包快捷栏里的 item 放到指定坐标（须为空气且贴着实体面，RCON 复核放置结果）。",
      "scopes": [
        "domain:mc",
        "mcclient"
      ],
      "allow_internal": true,
      "parameters": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "要放到的 X 坐标"
          },
          "y": {
            "type": "number",
            "description": "要放到的 Y 坐标"
          },
          "z": {
            "type": "number",
            "description": "要放到的 Z 坐标"
          },
          "item": {
            "type": "string",
            "description": "物品 id，可省略",
            "default": ""
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/place?x={{x}}&y={{y}}&z={{z}}&item={{item}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
