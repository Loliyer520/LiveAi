        "required": [
          "taskId"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/schedule/cancel?taskId={{taskId}}&reason={{reason}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    }
  ]
