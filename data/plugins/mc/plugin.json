          "z"
        ]
      },
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:7660/dig?x={{x}}&y={{y}}&z={{z}}",
        "headers": {
          "Authorization": "Bearer {{secrets.MCBOT_TOKEN}}"
        }
      },
      "response": {
        "format": "json",
        "code_path": "ok",
        "ok_value": true,
        "msg_path": "message",
        "template": "{{message}}"
      }
    },
    {
      "name": "mc_place",
      "description": "在指定空位放方块。item 可指定物品 id（如 dirt/cobblestone/oak_planks），省略则用背包第一个可放置方块。目标周围必须有实体方块可依附，不能放在自己脚下。",
      "scopes": [
