+    pub fn dig_at(&self, pos: [i32; 3], face: u8, hold_ms: u64) -> Result<()> {
+        let mut data = self.shared.lock().unwrap();
+        if data.pending_block_actions.len() >= 16 {
+            return Err("Block action queue exceeds budget".into());
+        }
