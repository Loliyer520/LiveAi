+/// 给定方块坐标与朝向，返回该面中心的世界坐标点（use_on 包的 cursor 位置）。
+fn face_point(pos: [i32; 3], face: u8) -> [f64; 3] {
+    let (dx, dy, dz) = match face {
+        0 => (0.5, 0.0, 0.5), // down
+        1 => (0.5, 1.0, 0.5), // up
+        2 => (0.5, 0.5, 0.0), // north (-Z)
+        3 => (0.5, 0.5, 1.0), // south (+Z)
+        4 => (0.0, 0.5, 0.5), // west (-X)
+        _ => (1.0, 0.5, 0.5), // east (+X)
+    };
+    [
+        f64::from(pos[0]) + dx,
+        f64::from(pos[1]) + dy,
+        f64::from(pos[2]) + dz,
+    ]
+}
